msgstr "Más información"

#: src/Service/FinderService.php:50
msgid "Start over"
msgstr "Empezar de nuevo"

#: src/Service/FinderService.php:51
msgid "Back"
msgstr "Atrás"

#: src/Service/FinderService.php:52
msgid "Step {current} of {total}"
msgstr "Paso {current} de {total}"

#: src/Service/FinderService.php:53
msgid "Pick an option to continue."
msgstr "Elige una opción para continuar."

#: src/Service/FinderService.php:54
msgid "Here is your match!"
msgstr "¡Aquí tienes tu producto!"

#: src/Service/FinderService.php:55
msgid "Finding your match…"
msgstr "Buscando tu producto…"

#: src/Service/FinderService.php:56
msgid "We could not find a match. Please try again."
msgstr "No hemos encontrado un producto. Inténtalo de nuevo."

#: src/Service/FinderService.php:57
msgid "That recommendation is not available right now."
msgstr "Esa recomendación no está disponible en este momento."

#: src/Service/FinderService.php:58
msgid "Something went wrong. Please try again."
msgstr "Algo ha salido mal. Inténtalo de nuevo."

#: templates/finder.php:50
msgid "Quiz progress"
msgstr "Progreso del cuestionario"

#: templates/finder.php:111
msgid "Please enable JavaScript to use the product finder."
msgstr "Activa JavaScript para usar el buscador de productos."

